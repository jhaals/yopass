{
  "name": "website2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check . && node scripts/check-locales.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run && playwright test",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:unit:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "i18next": "^27.2.6",
    "i18next-browser-languagedetector": "^8.3.1",
    "openpgp": "^6.3.3",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "daisyui": "^5.8.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
